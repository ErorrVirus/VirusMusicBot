# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=

# Lavalink Connection
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change_this_to_a_strong_password

# Optional YouTube & Spotify Credentials
# Leave disabled/blank unless you configure credentials; bot still resolves Spotify via embed fallback
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
LAVASRC_SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SPDC=

# Persistent Storage, Playback & Security Limits
DB_PATH=./data/virusmusic.db
MAX_PLAYLIST_SIZE=250
VOICE_READY_TIMEOUT_MS=10000
ALLOW_HTTP_STREAMS=false
LOG_LEVEL=info

# Web Dashboard (disabled by default until credentials and LAN/HTTPS access are configured)
DASHBOARD_ENABLED=false
# Bind to 127.0.0.1 for local-only/tunnel access, or your TrueNAS LAN IP (e.g. 192.168.1.50)
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=4000
DASHBOARD_USER=admin
# Provide DASHBOARD_PASS_HASH (scrypt:salt:hash) OR DASHBOARD_PASS
DASHBOARD_PASS=
DASHBOARD_PASS_HASH=
# MUST be a separate random 32+ char secret (e.g. openssl rand -hex 32)
DASHBOARD_JWT_SECRET=
TRUST_PROXY=false

# Optional Native HTTPS Certificates (place certificate.crt & private.key in ./certs)
SSL_CRT_PATH=
SSL_KEY_PATH=
SSL_CERTS_HOST_DIR=./certs
